// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql" 
}

// -------------------------------------------------------------
// MODELOS DE BETTER AUTH (Necesarios para la autenticación)
// -------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// -------------------------------------------------------------
// MODELOS DE NEGOCIO (TikkiGuau CMS)
// -------------------------------------------------------------

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

enum DeliveryMethod {
  PICKUP // Retiro en tienda
  CORREO_DOMICILIO
  CORREO_SUCURSAL
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique // Ej: "TK-1001"
  status          OrderStatus    @default(PENDING)
  
  // Datos del contacto / invitado
  firstName       String
  lastName        String
  email           String
  phone           String
  
  // Datos de envío
  deliveryMethod  DeliveryMethod
  address         String?
  city            String?
  zipCode         String?
  trackingCode    String?        // Para cargar el código de Correo Argentino
  
  // Costos y productos
  totalAmount     Float          // Costo total de items + envío
  orderItems      Json           // El JSON estructurado del carrito

  // Tienda origen (solo si fue creada desde la app de tiendas)
  storeId         String?
  store           Store?         @relation(fields: [storeId], references: [id])
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("orders")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  keyword   String   @unique
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stores")
}

// -------------------------------------------------------------
// CATÁLOGO DINÁMICO (CMS)
// -------------------------------------------------------------

enum CatalogProductType {
  COLLAR
  LEASH
  BOTH
}

model CatalogBaseColor {
  id        String   @id @default(cuid())
  name      String
  hexValue  String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catalog_base_colors")
}

model CatalogElementColor {
  id           String              @id @default(cuid())
  hexValue     String              @unique
  isActive     Boolean             @default(true)
  sortOrder    Int                 @default(0)
  letterColors CatalogLetterColor[]
  emojiColors  CatalogEmojiColor[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("catalog_element_colors")
}

model CatalogLetter {
  id        String               @id @default(cuid())
  letter    String               @unique @db.Char(1)
  isActive  Boolean              @default(true)
  sortOrder Int                  @default(0)
  colors    CatalogLetterColor[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@map("catalog_letters")
}

model CatalogLetterColor {
  letterId       String
  elementColorId String
  letter         CatalogLetter       @relation(fields: [letterId], references: [id], onDelete: Cascade)
  elementColor   CatalogElementColor @relation(fields: [elementColorId], references: [id], onDelete: Cascade)

  @@id([letterId, elementColorId])
  @@map("catalog_letter_colors")
}

model CatalogEmoji {
  id              String              @id @default(cuid())
  key             String              @unique
  label           String
  svgMarkup       String              @db.Text
  isActive        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  /// Tallas en las que el emoji está disponible ("1" | "2")
  availableSizes  String[]            @default(["1", "2"])
  colors          CatalogEmojiColor[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("catalog_emojis")
}

model CatalogEmojiColor {
  emojiId        String
  elementColorId String
  emoji          CatalogEmoji        @relation(fields: [emojiId], references: [id], onDelete: Cascade)
  elementColor   CatalogElementColor @relation(fields: [elementColorId], references: [id], onDelete: Cascade)

  @@id([emojiId, elementColorId])
  @@map("catalog_emoji_colors")
}

model ProductPrice {
  id          String             @id @default(cuid())
  productType CatalogProductType @unique
  amountArs   Int
  pieces      Int
  label       String
  description String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("product_prices")
}

model ShippingPrice {
  id             String         @id @default(cuid())
  deliveryMethod DeliveryMethod @unique
  amountArs      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("shipping_prices")
}